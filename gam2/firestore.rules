
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(workshopId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workshops/$(workshopId)/members/$(request.auth.uid));
    }

    function role(workshopId) {
      return get(/databases/$(database)/documents/workshops/$(workshopId)/members/$(request.auth.uid)).data.role;
    }

    function isStaff(workshopId) {
      return isMember(workshopId) && (role(workshopId) == 'staff' || role(workshopId) == 'admin');
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
    }

    match /workshops/{workshopId}/members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff(workshopId));
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'client';
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.role == request.resource.data.role;
      allow write: if isStaff(workshopId);
    }

    match /workshops/{workshopId}/chats/{chatId} {
      allow create: if signedIn() && request.resource.data.clientUid == request.auth.uid;
      allow read, update: if signedIn() &&
        (resource.data.clientUid == request.auth.uid || isStaff(workshopId));

      match /messages/{messageId} {
        allow read: if signedIn() &&
          (get(/databases/$(database)/documents/workshops/$(workshopId)/chats/$(chatId)).data.clientUid == request.auth.uid
            || isStaff(workshopId));
        allow create: if signedIn() &&
          ((request.resource.data.senderId == request.auth.uid &&
            get(/databases/$(database)/documents/workshops/$(workshopId)/chats/$(chatId)).data.clientUid == request.auth.uid)
            || isStaff(workshopId));
      }
    }

    match /workshops/{workshopId}/bookings/{bookingId} {
      allow create: if signedIn() && request.resource.data.clientUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.clientUid == request.auth.uid || isStaff(workshopId));
      allow update, delete: if isStaff(workshopId);
    }

    match /workshops/{workshopId}/repairs/{clientUid} {
      allow read: if signedIn() && (clientUid == request.auth.uid || isStaff(workshopId));
      allow create, update, delete: if isStaff(workshopId);

      match /approvals/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isStaff(workshopId));
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.clientUid == request.auth.uid;
      }
    }
  }
}
